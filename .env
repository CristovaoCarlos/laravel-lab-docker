# Variáveis usadas pelo docker-compose.yml (não são as do Laravel).
# Todas as senhas abaixo são apenas para estudo local.

# UID/GID do seu usuário no host. No Linux/WSL rode `id -u` e `id -g`.
HOST_UID=1000
HOST_GID=1000

# Portas expostas no seu computador
APP_PORT=8000
DB_PORT_HOST=3307
ADMINER_PORT=8080

# Banco de dados
DB_DATABASE=laravel_lab
DB_USERNAME=lab
DB_PASSWORD=lab_secret
DB_ROOT_PASSWORD=root_secret

# Versão do Laravel na primeira instalação. Vazio = última versão estável.
# Exemplos: ^12.0  ou  ^13.0
LARAVEL_VERSION=
